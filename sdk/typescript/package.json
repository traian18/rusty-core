{
  "name": "@rusty/harness-sdk",
  "version": "0.1.0-alpha.0",
  "description": "Application-agnostic TypeScript SDK for the Rusty agent harness (harnessd wire protocol v2).",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/test/client.test.js"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.14.0"
  }
}
